    "configuration": {
      "title": "SiteDock · GitHub Updates",
      "properties": {
        "sitedock.updates.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check GitHub Releases for SiteDock updates when VS Code starts and periodically while open."
        },
        "sitedock.updates.channel": {
          "type": "string",
          "enum": [
            "stable",
            "beta"
          ],
          "default": "stable",
          "enumDescriptions": [
            "Install non-pre-release versions only.",
            "Include pre-release builds, plus stable versions."
          ],
          "description": "GitHub release channel to track."
        },
        "sitedock.updates.repository": {
          "type": "string",
          "default": "gigabytegrove/vscode-sitedock",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[-A-Za-z0-9_.]+$",
          "description": "Public GitHub repository containing SiteDock releases (owner/repo). Official releases are published at gigabytegrove/vscode-sitedock; no separate repository or extension credentials required."
        },
        "sitedock.updates.checkIntervalHours": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 168,
          "description": "Minimum time between automatic update checks, in hours (1–168)."
        },
        "sitedock.updates.autoInstall": {
          "type": "boolean",
          "default": false,
          "description": "Automatically download and install checksum-verified GitHub updates without asking first, then prompt to reload. Disabled by default."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
