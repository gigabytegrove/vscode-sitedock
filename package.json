        },
        {
          "command": "sitedock.groupSite",
          "when": "view == sitedock.sites && viewItem == sitedock.site",
          "group": "2_manage@5"
        },
        {
          "command": "sitedock.duplicateSite",
          "when": "view == sitedock.sites && viewItem == sitedock.site",
          "group": "2_manage@6"
        },
        {
          "command": "sitedock.searchRemote",
          "when": "view == sitedock.sites && viewItem == sitedock.site",
          "group": "1_navigation@5"
        },
        {
          "command": "sitedock.batchMove",
          "when": "view == sitedock.sites && (viewItem == sitedock.file || viewItem == sitedock.directory || viewItem == sitedock.fileLink || viewItem == sitedock.directoryLink)",
