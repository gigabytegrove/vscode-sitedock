{
  "name": "sitedock",
  "displayName": "SiteDock — Live FTP & SFTP",
  "description": "Multi-site FTP, FTPS and SFTP editor with organized Site Manager, safe remote file search, verified GitHub updates, and transfer activity.",
  "version": "0.7.0",
  "publisher": "GigabyteGrove",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "ftp",
    "ftps",
    "sftp",
    "remote",
    "live edit",
    "multi site",
    "site manager",
    "site workspace",
    "dreamweaver",
    "remote files"
  ],
  "activationEvents": [
    "onCommand:sitedock.add",
    "onCommand:sitedock.edit",
    "onCommand:sitedock.remove",
    "onCommand:sitedock.test",
    "onCommand:sitedock.refresh",
    "onCommand:sitedock.open",
    "onCommand:sitedock.newFile",
    "onCommand:sitedock.newFolder",
    "onCommand:sitedock.rename",
    "onCommand:sitedock.delete",
    "onCommand:sitedock.upload",
    "onCommand:sitedock.download",
    "onCommand:sitedock.openRoot",
    "onView:sitedock.sites",
    "onFileSystem:sitedock",
    "onCommand:sitedock.diagnostics",
    "onCommand:sitedock.installLibraries",
    "onCommand:sitedock.authDiagnostics",
    "onView:sitedock.activity",
    "onCommand:sitedock.showActivity",
    "onCommand:sitedock.clearActivity",
    "onCommand:sitedock.cancelActivity",
    "onCommand:sitedock.activityDetails",
    "onCommand:sitedock.uploadFolder",
    "onCommand:sitedock.downloadFolder",
    "onCommand:sitedock.retryActivity",
    "onCommand:sitedock.openAsText",
    "onCommand:sitedock.openExternal",
    "onCommand:sitedock.manager",
    "onCommand:sitedock.openSite",
    "onCommand:sitedock.focusSite",
    "onCommand:sitedock.closeSite",
    "onCommand:sitedock.closeOthers",
    "onCommand:sitedock.closeAllSites",
    "onCommand:sitedock.toggleFavorite",
    "onCommand:sitedock.openSiteWindow",
    "onCommand:sitedock.switchSite",
    "onCommand:sitedock.openMultiple",
    "onCommand:sitedock.setViewMode",
    "onView:sitedock.managerSites",
    "onCommand:sitedock.checkUpdates",
    "onCommand:sitedock.updateSettings",
    "onCommand:sitedock.viewReleases"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sitedock",
          "title": "SiteDock",
